APP_ENV=development

# PostgreSQL connection string (psycopg v3 driver)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://dealflow:dealflow@localhost:5432/dealflow

# API base (used by the frontend)
API_BASE_URL=http://localhost:8000

# IMPORTANT: Generate a strong secret before deploying to any shared environment.
# Command: openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# --- Optional AI provider (not used by auth) ---
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
